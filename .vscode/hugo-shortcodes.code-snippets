{
  // Place your un-aligned-hugo workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "Similar article": {
    "prefix": "sim",
    "body": ["{{< sim \"$1\" >}}"],
    "description": "Similar article card"
  },

  "Photo Normal": {
    "prefix": "photo-normal",
    "body": ["{{< photo-normal src=\"$1\" caption=\"$2\" >}}"],
    "description": "Standard size photo"
  },

  "Photo Large": {
    "prefix": "photo-large",
    "body": ["{{< photo-large src=\"$1\" caption=\"$2\" >}}"],
    "description": "Large photo layout"
  },

  "Photo Extra Large": {
    "prefix": "photo-xlarge",
    "body": ["{{< photo-xlarge src=\"$1\" caption=\"$2\" >}}"],
    "description": "Extra large photo layout"
  },

  "Photo Custom": {
    "prefix": "photo-custom",
    "body": ["{{< photo-custom src=\"$1\" width=\"$2(23)\" caption=\"$3\" >}}"],
    "description": "Custom width photo"
  }
}
